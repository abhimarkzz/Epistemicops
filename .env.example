# ── LLM provider ──────────────────────────────────────────────────────────────
# Backend only — NEVER put any API key in frontend/.env or any VITE_ variable.
# Provider is "gemini" (default) or "groq". Leave blank to auto-select: Groq is
# used when GROQ_API_KEY is set, otherwise Gemini.
LLM_PROVIDER=

# Gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.8-flash

# Groq — free tier. Get a key at https://console.groq.com
# When set (and LLM_PROVIDER is blank or "groq"), the agent uses Groq for diagnosis.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Hindsight ─────────────────────────────────────────────────────────────────
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
HINDSIGHT_BANK_ID=epistemic-sre
HINDSIGHT_MENTAL_MODEL_ID=microservice-resolution-runbook

# ── Backend ───────────────────────────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGIN=http://localhost:5173
MAX_AGENT_STEPS=8
LLM_TIMEOUT=60
